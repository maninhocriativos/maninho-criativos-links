{
  "name": "maninho-criativos-links",
  "version": "1.0.0",
  "description": "Página de links premium — Maninho Criativos",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "npx wrangler pages deploy public",
    "db:create": "npx wrangler d1 create maninho-links-db",
    "db:migrate": "wrangler d1 migrations apply maninho-links-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply maninho-links-db --remote",
    "check": "node scripts/check.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
